// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id           Int      @id @default(autoincrement())
  employeeId   String?  @unique @map("employee_id")
  username     String?  @unique
  email        String   @unique
  password     String
  name         String
  role         String   @default("admin")
  department   String?
  mfaEnabled   Boolean  @default(false) @map("mfa_enabled")
  mfaSecret    String?  @map("mfa_secret")
  backupCodes  String?  @map("backup_codes")
  isActive     Boolean  @default(true) @map("is_active")
  portalAccess String   @default("both") @map("portal_access") // perusahaan | karir | both
  isFirstLogin Boolean  @default(true) @map("is_first_login")
  createdAt    DateTime @default(now()) @map("created_at")
  updatedAt    DateTime @updatedAt @map("updated_at")

  @@map("users")
}

model SiteSetting {
  id    Int    @id @default(autoincrement())
  key   String @unique
  value String @db.Text

  @@map("site_settings")
}

model NavMenu {
  id            Int       @id @default(autoincrement())
  title         String
  url           String
  location      String    // navbar | footer | admin_sidebar | admin_top
  section       String?
  sortOrder     Int       @default(0) @map("sort_order")
  isActive      Boolean   @default(true) @map("is_active")
  isMaintenance Boolean   @default(false) @map("is_maintenance")
  portal        String    @default("perusahaan") // perusahaan | karir | both
  allowedRoles  String?   @map("allowed_roles") // CSV NULL=all
  icon          String?
  parentId      Int?      @map("parent_id")
  parent        NavMenu?  @relation("NavMenuHierarchy", fields: [parentId], references: [id], onDelete: Cascade)
  children      NavMenu[] @relation("NavMenuHierarchy")
  createdAt     DateTime  @default(now()) @map("created_at")
  updatedAt     DateTime  @updatedAt @map("updated_at")

  @@map("nav_menus")
}

model AdminMenu {
  id           Int       @id @default(autoincrement())
  title        String
  url          String
  portal       String    @default("perusahaan") // perusahaan | karir | both
  location     String    @default("admin_sidebar") // admin_sidebar | admin_top
  icon         String?
  section      String?
  sortOrder    Int       @default(0) @map("sort_order")
  isActive     Boolean   @default(true) @map("is_active")
  allowedRoles String?   @map("allowed_roles") // CSV NULL=all
  parentId     Int?      @map("parent_id")
  parent       AdminMenu? @relation("AdminMenuHierarchy", fields: [parentId], references: [id], onDelete: Cascade)
  children     AdminMenu[] @relation("AdminMenuHierarchy")
  createdAt    DateTime  @default(now()) @map("created_at")
  updatedAt    DateTime  @updatedAt @map("updated_at")

  @@map("admin_menus")
}

model HeroSection {
  id               Int      @id @default(autoincrement())
  page             String
  title            String
  subtitle         String?  @db.Text
  image            String?
  imageAlt         String?  @map("image_alt")
  primaryBtnText   String?  @map("primary_btn_text")
  primaryBtnUrl    String?  @map("primary_btn_url")
  secondaryBtnText String?  @map("secondary_btn_text")
  secondaryBtnUrl  String?  @map("secondary_btn_url")
  isActive         Boolean  @default(true) @map("is_active")
  createdAt        DateTime @default(now()) @map("created_at")
  updatedAt        DateTime @updatedAt @map("updated_at")

  @@map("hero_sections")
}

model Announcement {
  id        Int       @id @default(autoincrement())
  message   String
  btnText   String?   @map("btn_text")
  btnUrl    String?   @map("btn_url")
  isActive  Boolean   @default(true) @map("is_active")
  startAt   DateTime? @map("start_at")
  endAt     DateTime? @map("end_at")
  createdAt DateTime  @default(now()) @map("created_at")
  updatedAt DateTime  @updatedAt @map("updated_at")

  @@map("announcements")
}

model Partner {
  id        Int      @id @default(autoincrement())
  name      String
  logo      String
  logoType  String   @default("image") @map("logo_type")
  url       String?
  sortOrder Int      @default(0) @map("sort_order")
  isActive  Boolean  @default(true) @map("is_active")
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@map("partners")
}

model Feature {
  id          Int      @id @default(autoincrement())
  title       String
  description String   @db.Text
  svgIcon     String?  @map("svg_icon") @db.Text
  section     String   @default("general")
  sortOrder   Int      @default(0) @map("sort_order")
  isActive    Boolean  @default(true) @map("is_active")
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  @@map("features")
}

model Service {
  id          Int      @id @default(autoincrement())
  title       String
  subtitle    String?
  description String?  @db.Text
  image       String?
  slug        String   @unique
  sortOrder   Int      @default(0) @map("sort_order")
  isActive    Boolean  @default(true) @map("is_active")
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  @@map("services")
}

model Product {
  id          Int      @id @default(autoincrement())
  title       String
  category    String   @default("mobil")
  description String?  @db.Text
  image       String?
  slug        String   @unique
  price       Decimal? @db.Decimal(12, 2)
  isActive    Boolean  @default(true) @map("is_active")
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  @@map("products")
}

model BlogPost {
  id          Int       @id @default(autoincrement())
  title       String
  slug        String    @unique
  excerpt     String?   @db.Text
  content     String    @db.Text
  image       String?
  author      String?
  isPublished Boolean   @default(false) @map("is_published")
  publishedAt DateTime? @map("published_at")
  createdAt   DateTime  @default(now()) @map("created_at")
  updatedAt   DateTime  @updatedAt @map("updated_at")

  @@map("blog_posts")
}

model Testimonial {
  id        Int      @id @default(autoincrement())
  name      String
  role      String?
  company   String?
  content   String   @db.Text
  avatar    String?
  rating    Int      @default(5)
  isActive  Boolean  @default(true) @map("is_active")
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@map("testimonials")
}

model Faq {
  id        Int      @id @default(autoincrement())
  question  String
  answer    String   @db.Text
  sortOrder Int      @default(0) @map("sort_order")
  isActive  Boolean  @default(true) @map("is_active")
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@map("faqs")
}

model Statistic {
  id        Int      @id @default(autoincrement())
  label     String
  value     String
  page      String   @default("home")
  sortOrder Int      @default(0) @map("sort_order")
  isActive  Boolean  @default(true) @map("is_active")
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@map("statistics")
}

model ContactSubmission {
  id        Int      @id @default(autoincrement())
  name      String
  email     String
  subject   String?
  message   String   @db.Text
  isRead    Boolean  @default(false) @map("is_read")
  createdAt DateTime @default(now()) @map("created_at")

  @@map("contact_submissions")
}

model Certification {
  id                Int       @id @default(autoincrement())
  title             String
  issuer            String
  certificateNumber String?   @map("certificate_number")
  issuedDate        DateTime? @map("issued_date")
  expiryDate        DateTime? @map("expiry_date")
  image             String?
  description       String?   @db.Text
  sortOrder         Int       @default(0) @map("sort_order")
  isActive          Boolean   @default(true) @map("is_active")
  createdAt         DateTime  @default(now()) @map("created_at")
  updatedAt         DateTime  @updatedAt @map("updated_at")

  @@map("certifications")
}

model Facility {
  id             Int      @id @default(autoincrement())
  title          String
  category       String   @default("Produksi")
  image          String?
  description    String?  @db.Text
  specifications String?  @db.Text
  sortOrder      Int      @default(0) @map("sort_order")
  isActive       Boolean  @default(true) @map("is_active")
  createdAt      DateTime @default(now()) @map("created_at")
  updatedAt      DateTime @updatedAt @map("updated_at")

  @@map("facilities")
}

model SustainabilityReport {
  id               Int      @id @default(autoincrement())
  title            String
  category         String   @default("general")
  categoryTitleEn  String?  @map("category_title_en")
  categoryTitleId  String?  @map("category_title_id")
  categoryDescEn   String?  @map("category_desc_en") @db.Text
  categoryDescId   String?  @map("category_desc_id") @db.Text
  categoryBadge    String?  @map("category_badge")
  fileUrl          String   @map("file_url")
  fileType         String   @default("PDF") @map("file_type")
  fileSize         String?  @map("file_size")
  tag              String?
  sortOrder        Int      @default(0) @map("sort_order")
  isActive         Boolean  @default(true) @map("is_active")
  createdAt        DateTime @default(now()) @map("created_at")
  updatedAt        DateTime @updatedAt @map("updated_at")

  @@map("sustainability_reports")
}