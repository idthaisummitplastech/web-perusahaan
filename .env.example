# Backend API Configuration (Zero Direct DB Access) — WAJIB via env, tanpa kredensial asli.
# 100% via env (lihat src/lib/urls.ts) — ganti domain cukup sentuh .env.
# Port runtime: backend:8004, web-perusahaan:3008, web-karir:3009.
BACKEND_API_URL="http://localhost:8004/api/v1"
BACKEND_INTERNAL_SECRET="change-me-min-32-chars-via-env"

NEXTAUTH_SECRET="change-me-min-32-chars-via-env"
NEXTAUTH_URL="http://localhost:3008"

# URL publik — 100% via env (lihat src/lib/urls.ts + app/(public)/careers/page.tsx).
NEXT_PUBLIC_CAREER_URL="http://localhost:3009"
CAREER_SITE_URL="http://localhost:3009"
NEXT_PUBLIC_COMPANY_URL="http://localhost:3008"
COMPANY_SITE_URL="http://localhost:3008"

SMTP_HOST=""
SMTP_PORT=465
SMTP_USER=""
SMTP_PASS=""
SMTP_FROM=""
SMTP_FROM_EMAIL=""
SMTP_FROM_NAME="PT ITSP Marketing"

# Seed passwords (min 12 karakter) — WAJIB via env untuk `prisma db seed`.
SEED_ADMIN_PASSWORD="change-me-min-12-chars"
SEED_MARKETING_PASSWORD="change-me-min-12-chars"
# WAJIB (min 12 karakter): password awal superadmin utama it-04. Seed berhenti dengan error bila kosong/pendek.
# Tanpa fallback default. Seed tidak menimpa password akun yang sudah ada.
SEED_IT04_PASSWORD="change-me-min-12-chars"
